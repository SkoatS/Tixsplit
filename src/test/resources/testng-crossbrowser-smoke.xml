<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="CrossBrowserSmokeSuite" parallel="tests" thread-count="2">

    <!-- Chrome Smoke Execution -->
    <test name="ChromeSmoke">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="tests.AuthTests"/>
        </classes>
    </test>

    <!-- Firefox Smoke Execution -->
    <test name="FirefoxSmoke">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="tests.AuthTests"/>
        </classes>
    </test>

</suite>

