<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
 Cross-Browser Test Suite:
 Runs the test suite across multiple browsers (Chrome, Firefox, Edge).
 Each <test> block injects its respective browser parameter into BaseTests.setUp().
-->
<suite name="CrossBrowserTestSuite" parallel="tests" thread-count="2">

    <!-- Chrome Browser Run -->
    <test name="ChromeExecution">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="tests.AuthTests"/>
            <class name="tests.CommunityTests"/>
            <class name="tests.EventTests"/>
            <class name="tests.PaymentTests"/>
            <class name="tests.api.ParallelCheckoutApiTests"/>
            <class name="tests.SplitBillTests"/>
        </classes>
    </test>

    <!-- Firefox Browser Run -->
    <test name="FirefoxExecution">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="tests.AuthTests"/>
            <class name="tests.CommunityTests"/>
            <class name="tests.EventTests"/>
            <class name="tests.PaymentTests"/>
            <class name="tests.api.ParallelCheckoutApiTests"/>
            <class name="tests.SplitBillTests"/>
        </classes>
    </test>

    <!-- Edge Browser Run (requires msedgedriver setup)
    <test name="EdgeExecution">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="tests.AuthTests"/>
            <class name="tests.CommunityTests"/>
            <class name="tests.EventTests"/>
            <class name="tests.PaymentTests"/>
            <class name="tests.api.ParallelCheckoutApiTests"/>
            <class name="tests.SplitBillTests"/>
        </classes>
    </test>
    -->

</suite>

