<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
 Parallel Execution configuration:
 parallel="methods" -> each @Test method runs in its isolated thread
 thread-count       -> maximum concurrent threads
 ThreadLocal<WebDriver> in DriverManager ensures complete browser isolation per thread
-->
<suite name="TixSplitAutomationSuite" parallel="methods" thread-count="3">

    <parameter name="browser" value="chrome"/>

    <test name="SmokeAndRegressionTests">
        <classes>
            <class name="tests.AuthTests"/>
            <class name="tests.CommunityTests"/>
            <class name="tests.EventTests"/>
            <class name="tests.PaymentTests"/>
            <class name="tests.api.ParallelCheckoutApiTests"/>
            <class name="tests.SplitBillTests"/>
        </classes>
    </test>

</suite>

